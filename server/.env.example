# Server runtime config. Copy to .env and fill in real values locally; never commit .env.
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Supabase project (same project as the client). The anon key is enough both
# to verify user access tokens via supabase.auth.getUser() and to write room
# metadata as the user themselves (RLS enforces owner_id = auth.uid()) — no
# service role key is needed by this server.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Signs short-lived room-scoped session tokens (separate from Supabase's own
# JWTs). Generate a unique secret per environment, e.g. `openssl rand -base64 48`.
ROOM_TOKEN_SECRET=change-me
ROOM_TOKEN_TTL_SECONDS=1800

# How often the team code rotates, in ms. 30000 = 30s per the spec.
TEAM_CODE_ROTATION_MS=30000

# Abuse/cost limits.
MAX_ROOMS_PER_USER=5
MAX_TOTAL_ROOMS=200
MAX_PARTICIPANTS_PER_ROOM=12
MAX_FILES_PER_ROOM=300
MAX_FILE_SIZE_BYTES=2000000

# Shared terminal (M5). ulimits/uid/gid only take effect on POSIX — see
# server/src/services/terminalManager.ts for exactly what's enforced where.
TERMINAL_IDLE_TIMEOUT_MS=1200000
TERMINAL_SCROLLBACK_BYTES=200000
TERMINAL_MAX_VIRTUAL_MEMORY_KB=1500000
TERMINAL_MAX_PROCESSES=64
TERMINAL_MAX_CPU_SECONDS=600
# TERMINAL_UID=10001
# TERMINAL_GID=10001
