# Server runtime config. Copy to .env and fill in real values locally; never commit .env.
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Supabase project (same project as the client). The anon key is enough to
# verify user access tokens via supabase.auth.getUser() — no service role
# key is needed until M2 (server-side room metadata writes).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
